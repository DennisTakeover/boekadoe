# Copy to backend/.env and fill in. Never commit the real file.

# --- Instagram ---
# A real, logged-in Instagram account is required to call the private
# recommendation endpoints (chaining/discover). Using them is against
# Instagram's Terms of Service and carries a real risk of the account being
# flagged or banned — use a disposable/test account, not your main one.
# Leave both empty (or set USE_MOCK_ADAPTER=true) to run against the
# built-in fake adapter instead, e.g. for local development or a demo.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Only needed if the account has TOTP-based 2FA enabled (the seed shown when
# you set up an authenticator app, not a one-time SMS/email code).
INSTAGRAM_TOTP_SEED=
USE_MOCK_ADAPTER=false

# --- Niche classification ---
# Anthropic API key for AI niche classification (get one at console.anthropic.com).
# Without it, every candidate gets niche "unknown" but the rest of the pipeline
# still works fine.
ANTHROPIC_API_KEY=
NICHE_MODEL=claude-haiku-4-5-20251001

# --- Database ---
# Defaults to a local SQLite file. Point this at Postgres/Supabase for
# production, e.g. postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# --- Optional: Google Sheets export ---
# Path to a Google service-account JSON key file, shared as an editor on the
# target spreadsheet. Leave empty to disable the /export/sheets endpoint
# (CSV export always works regardless).
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- API ---
# Comma-separated list of origins allowed to call this API (the frontend URL).
CORS_ORIGINS=http://localhost:3000
